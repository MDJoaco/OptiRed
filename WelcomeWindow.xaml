<Window x:Class="OptiRed.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OptiRed"
        mc:Ignorable="d"
        Title="WelcomeWindow" Height="450" Width="800" Background="#FFC3C3C3">
    <Grid HorizontalAlignment="Center" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="413*"/>
            <ColumnDefinition Width="282*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="36*"/>
        </Grid.RowDefinitions>

        <Rectangle HorizontalAlignment="Center" Height="434" Grid.RowSpan="2" VerticalAlignment="Top" Width="325" Fill="#FF202020" Grid.Column="1"/>
        <Label x:Name="lblWelcome" Content="Bienvenido &#xD;&#xA;   de nuevo" HorizontalContentAlignment="Right" VerticalAlignment="Top" FontSize="54" HorizontalAlignment="Right" Height="197" Margin="0,106,37,0" Width="323" Grid.RowSpan="2"/>

        <Button x:Name="btnNuevoProyecto" Grid.Column="1" Content="Nuevo Proyecto" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Height="44" Width="236" FontSize="24" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" Margin="24,90,0,0" Click="btnNuevoProyecto_Click"/>
        <Button x:Name="btnEditarProyecto" Grid.Column="1" Content="Editar Proyecto" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Height="44" Width="236" FontSize="24" Background="{x:Null}" BorderBrush="{x:Null}" Margin="24,180,0,0" Foreground="White" Click="btnEditarProyecto_Click"/>
        <Button x:Name="btnPreferencias" Grid.Column="1" Content="Preferencias" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Height="44" Width="236" FontSize="24" Background="{x:Null}" BorderBrush="{x:Null}" Margin="24,32,0,0" Grid.Row="1" Foreground="White"/>
    </Grid>
</Window>
