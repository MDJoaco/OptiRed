<Window x:Class="OptiRed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OptiRed"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="36*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="800">
            <Label Grid.Row="0" Content="Bienvenido de nuevo" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"/>
        </Grid>
        
        <Button Grid.Column="1" Content="Nuevo Proyecto" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Editar Proyecto" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
