<Window x:Class="OptiRed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OptiRed"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RowDefinitions="Auto,*,Auto">
        <Menu Background="#FF9E9E9E" Grid.Row="0">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo Proyecto" InputGestureText="Ctrl+N"></MenuItem>
                <MenuItem Header="_Abrir Proyecto" InputGestureText="Ctrl+O"></MenuItem>
                <MenuItem Header="Guardar Como" InputGestureText="Ctrl+Shift+S"></MenuItem>
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S"></MenuItem>
            </MenuItem>
            <MenuItem Header="Editar"></MenuItem>
            <MenuItem Header="Vista">
                <MenuItem
                    x:Name="Menu_ShowConsole"
                    Header="Mostrar consola"
                    IsCheckable="True"
                    IsChecked="False"
                    StaysOpenOnClick="True"
                    Click="Menu_ShowConsole_Toggle"></MenuItem>
            </MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Aqui habria docmunetación si hubiera"></MenuItem>
            </MenuItem>
        </Menu>

        <Grid
            Background="#FF242424"
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400*"/>
                <ColumnDefinition Width="381*"/>
                <ColumnDefinition Width="19*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <DockPanel
                x:Name="dockAlgoritmoRutas"
                LastChildFill="True"
                MinWidth="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Label
                    x:Name="lblAlgoritmoRutas"
                    Content="Algoritmo:"
                    Margin="5,0,5,0"
                    Foreground="White"/>
                <ComboBox
                    x:Name="cbAlgoritmoRutas"
                    Margin="5,0,5,0"
                    SelectedIndex="0">
                    <ComboBoxItem
                        x:Name="optAlgoPasajeros"
                        Content="Priorizar Pasajeros"/>
                    <ComboBoxItem
                        x:Name="optAlgoDistancia"
                        Content="Priorizar Distancia"/>
                </ComboBox>
            </DockPanel>

            <StackPanel
                Grid.Row="1"
                x:Name="stackDataPath"
                MinWidth="300"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <DockPanel
                    Margin="5"
                    LastChildFill="True">
                    <Label
                        x:Name="lblDataPath"
                        Content="Pasajeros:"
                        Margin="5,0,5,0"
                        Foreground="White"/>
                    <Button x:Name="btnDataPath"
                        Content="📂"
                        Margin="5,0,5,0"
                        Width="25"
                        Height="25"
                        DockPanel.Dock="Right"/>
                    <TextBox
                        x:Name="txtDataPath"
                        Margin="5,0,5,0"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Stretch"
                        Text="C:\carpeta\archivo.csv"
                        FontSize="14"
                        AcceptsReturn="True"/>
                </DockPanel>

                <Button
                    x:Name="btnFiltrarPasajeros"
                    Content="Filtrar Pasajeros"
                    Margin="5"/>
                <Label
                    x:Name="lblSelectedPasajeros"
                    Content="Seleccionando %d pasajeros c:"
                    Margin="5"
                    Foreground="#FFBABABA"/>
            </StackPanel>

            <DockPanel
                Grid.Row="2"
                x:Name="dockOutPath"
                MinWidth="300"
                LastChildFill="True"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <Label
                    x:Name="lblOutPath"
                    Content="Guardar en:"
                    Margin="5,0,5,0"
                    Foreground="White"/>
                <Button
                    x:Name="btnOutPath"
                    Content="📂"
                    Margin="5,0,5,0"
                    Width="25"
                    Height="25"
                    DockPanel.Dock="Right"/>
                <TextBox
                    x:Name="txtOutPath"
                    Margin="5,0,5,0"
                    TextWrapping="Wrap"
                    Text="C:\carpeta\output\rutas.csv"
                    FontSize="14"
                    AcceptsReturn="True"/>
            </DockPanel>

            <Image
                Grid.Column="1"
                x:Name="imgMap"
                HorizontalAlignment="Left"
                Height="250"
                VerticalAlignment="Center"
                Width="250"
                Source="/Assets/mogus.jpg" Margin="75,0,0,0" Grid.Row="1"/>
            <Button
                Grid.Column="1"
                Grid.Row="2"
                x:Name="btnEditVariables"
                Content="Modificar Variables"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
        </Grid>
    </Grid>
</Window>
