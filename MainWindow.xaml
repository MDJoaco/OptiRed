<Window x:Class="OptiRed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OptiRed"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF242424">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="457*"/>
            <ColumnDefinition Width="343*"/>
        </Grid.ColumnDefinitions>
        <Menu Padding="5" VerticalAlignment="Top" Background="#FF9E9E9E" Grid.ColumnSpan="2">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo Proyecto" InputGestureText="Ctrl+N"></MenuItem>
                <MenuItem Header="_Abrir Proyecto" InputGestureText="Ctrl+O"></MenuItem>
                <MenuItem Header="Guardar Como" InputGestureText="Ctrl+Shift+S"></MenuItem>
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S"></MenuItem>
            </MenuItem>
            <MenuItem Header="Editar"></MenuItem>
            <MenuItem Header="Vista">
                <MenuItem Header="Mostrar consola" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True"></MenuItem>
            </MenuItem>
            <MenuItem Header="Mostrar consola"></MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Aqui habria docmunetación si hubiera"></MenuItem>
            </MenuItem>
        </Menu>

        <Image x:Name="imgMap" HorizontalAlignment="Left" Height="250" Margin="78,43,0,0" VerticalAlignment="Top" Width="250" Source="/Assets/mogus.jpg" Grid.Column="1"></Image>

        <Grid x:Name="gridMainView" HorizontalAlignment="Left" Height="215" Margin="42,78,0,0" VerticalAlignment="Top" Width="448" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="107*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <DockPanel x:Name="dockDataPath" Height="26" VerticalAlignment="Top" Width="448" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="176,0,0,0">
            <Label x:Name="lblDataPath" Content="Pasajeros" Width="100" Foreground="White"/>

            <TextBox x:Name="txtDataPath" TextWrapping="Wrap" Text="C:\carpeta\archivo.csv" Width="233" TextChanged="txtDatapath_TextChanged" FontSize="14" Height="26" AcceptsReturn="True"/>
            <Button x:Name="btnDataPath" Content="📂" Width="29" Click="Button_Click"/>
            <Button x:Name="btnFiltrarPasajeros" Content=":D" Width="40" Click="btnFiltrarPasajeros_Click"/>
        </DockPanel>

        <Button x:Name="btnEditVariables" Content="Modificar Variables" Click="Button_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20" Width="105" Grid.Column="1"/>
        <Label x:Name="lblSelectedPasajeros" Content="Seleccionando %d pasajeros c:" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="296" Foreground="#FFBABABA" Margin="252,28,0,0" Grid.ColumnSpan="2"/>
        <Grid x:Name="gridSettings" HorizontalAlignment="Left" Height="73" VerticalAlignment="Center" Width="370" Grid.ColumnSpan="2" Margin="215,0,0,0">
            <DockPanel x:Name="dockAlgoritmoRutas" Height="26" LastChildFill="False" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Label x:Name="lblAlgoritmoRutas" Content="Algoritmo" Width="137" Foreground="White"/>
                <ComboBox x:Name="cbAlgoritmoRutas" Width="232" SelectedIndex="0">
                    <ComboBoxItem x:Name="optAlgoPasajeros" Content="Priorizar Pasajeros"/>
                    <ComboBoxItem x:Name="optAlgoDistancia" Content="Priorizar Distancia"/>
                </ComboBox>
            </DockPanel>
            <DockPanel x:Name="dockOutPath" Height="26" VerticalAlignment="Top" Width="370" HorizontalAlignment="Center" Margin="0,47,0,0">
                <Label x:Name="lblOutPath" Content="Guardar en" Width="100" Foreground="White"/>

                <TextBox x:Name="txtOutPath" TextWrapping="Wrap" Text="C:\carpeta\output\rutas.csv" Width="233" TextChanged="txtDatapath_TextChanged" FontSize="14" Height="26" AcceptsReturn="True"/>
                <Button x:Name="btnOutPath" Content="📂" Width="29" Click="Button_Click"/>
            </DockPanel>
        </Grid>
        <DockPanel HorizontalAlignment="Left" Height="25" LastChildFill="False" VerticalAlignment="Top" Width="800" d:IsHidden="True" Grid.ColumnSpan="2"/>
        <Button x:Name="btnShowConsole" Content="Mostrar consola" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Width="135" Margin="193,399,0,0" Grid.Column="1"/>

    </Grid>
</Window>
